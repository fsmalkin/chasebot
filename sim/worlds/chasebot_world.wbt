EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/nvidia/jetbot/protos/JetBot.proto"

WorldInfo {
  info [
    "ChaseBot Golf Ball Collection Simulation"
    "Phase 1: Basic vision and navigation testing"
  ]
  title "ChaseBot Simulation World"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      coulombFriction [
        8
      ]
      bounce 0.1
    }
  ]
}

Viewpoint {
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0 0 3
  follow "JetBot"
  followSmoothness 0.01
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  translation 0 0 0
  floorSize 4 4
  wallHeight 0.1
}

JetBot {
  translation 0 0 0.02
  rotation 0 0 1 0
  controller "<extern>"
  supervisor TRUE
  name "ChaseBot"
}

# Golf Ball 1
Solid {
  translation 1.5 0.5 0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        roughness 0.2
        metalness 0
      }
      geometry Sphere {
        radius 0.021
        subdivision 2
      }
    }
  ]
  name "golf_ball_1"
  boundingObject Sphere {
    radius 0.021
  }
  physics Physics {
    density -1
    mass 0.046
  }
}

