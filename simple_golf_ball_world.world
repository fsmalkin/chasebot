<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="golf_ball_world">
    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Simple white sphere representing a golf ball -->
    <model name="golf_ball">
      <pose>1.0 0.0 0.02 0 0 0</pose>
      <link name="ball_link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>0.000081</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.000081</iyy>
            <iyz>0.0</iyz>
            <izz>0.000081</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>0.9 0.9 0.9 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 0.0</emissive>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.7</restitution_coefficient>
            </bounce>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Additional golf balls for testing -->
    <model name="golf_ball_2">
      <pose>0.8 0.5 0.02 0 0 0</pose>
      <link name="ball_link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>0.000081</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.000081</iyy>
            <iyz>0.0</iyz>
            <izz>0.000081</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>0.9 0.9 0.9 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 0.0</emissive>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="golf_ball_3">
      <pose>1.2 -0.3 0.02 0 0 0</pose>
      <link name="ball_link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>0.000081</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.000081</iyy>
            <iyz>0.0</iyz>
            <izz>0.000081</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>0.9 0.9 0.9 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 0.0</emissive>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.02135</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
