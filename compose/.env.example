COMPOSE_PROJECT_NAME=chasecar_local
CORE_ROS_DISTRO=kilted
BRIDGE_ROS_DISTRO=jazzy
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:4.5.0
ISAAC_SIM_TAG=4.5.0
RUNTIME_TARGET=robot_fidelity_orin
SIM_LANE=jetty_gate
INFERENCE_BACKEND=tensorrt_int8
WORLD_FILE=yolo_test_world_v6_clean_uat.world
ROS_DOMAIN_ID=88
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
CHASECAR_UAT_MODE=full

# LLM recommender
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_SUPERVISOR_MODEL=gpt-5-nano
OPENAI_SUPERVISOR_REASONING_EFFORT=minimal
CHASECAR_LLM_PROVIDER=openai
