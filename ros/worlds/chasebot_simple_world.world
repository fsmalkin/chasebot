<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="chasebot_simple_world">
    
    <!-- Physics settings -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Single Golf Ball -->
    <model name="golf_ball">
      <pose>1.0 0 0.021 0 0 0</pose>
      <static>false</static>
      
      <link name="ball_link">
        <collision name="ball_collision">
          <geometry>
            <sphere>
              <radius>0.021</radius>
            </sphere>
          </geometry>
          <surface>
            <contact>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
                <kp>100000.0</kp>
                <kd>100.0</kd>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="ball_visual">
          <geometry>
            <sphere>
              <radius>0.021</radius>
            </sphere>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        
        <inertial>
          <mass>0.046</mass>
          <inertia>
            <ixx>8.232e-6</ixx>
            <iyy>8.232e-6</iyy>
            <izz>8.232e-6</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
  </world>
</sdf>
