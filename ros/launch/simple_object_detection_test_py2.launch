<?xml version="1.0"?>
<launch>
  <!-- ChaseBot Simple Object Detection Test Launch File -->
  <!-- Python 2.7 compatible version for ROS Melodic -->

  <!-- Launch the simulation environment with golf ball -->
  <include file="$(find chasebot_description)/launch/chasebot_simple_world.launch"/>

  <!-- Object Detection Node (Python 2.7 compatible) -->
  <node name="opencv_object_detector" pkg="chasebot_description" type="opencv_object_detection_test_py2.py" output="screen">
    <remap from="/camera/image_raw" to="/camera/image_raw"/>
    <remap from="/object_detection" to="/object_detection"/>
  </node>

  <!-- Simple UAT Test Node (Python 2.7 compatible) -->
  <node name="simple_object_detection_uat" pkg="chasebot_description" type="simple_object_detection_uat_py2.py" output="screen"/>

</launch>
