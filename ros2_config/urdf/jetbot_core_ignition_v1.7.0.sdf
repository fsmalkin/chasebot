<?xml version="1.0" ?>
<!--
JetBot Core Ignition Model - Version 1.7.0
Changes:
- v1.7.0: Added a passive front-mounted U-catcher for smooth-surface ball corralling
- v1.6.0: Separated RGB and depth sensors based on Depth_Camera_Simulation example
- v1.5.0: Modified depth camera to use rgbd_camera sensor type for Ignition compatibility
- v1.4.0: Added depth camera sensor to D415 for 3D position extraction
- v1.3.0: Added proper Ignition Gazebo camera sensor system plugin
- v1.2.0: Added basic RGB camera sensor to D415 camera link
- v1.1.0: Added D415 camera link (visual only) for camera integration testing
- v1.0.0: Initial working model with gz_ros2_control differential drive
-->
<sdf version="1.9">
  <model name="jetbot">
    
    <!-- Base Link - Main Chassis -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.0395</ixx>
          <iyy>0.0495</iyy>
          <izz>0.0595</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.15 0.12 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1.0</ambient>
          <diffuse>0.2 0.4 0.8 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.15 0.12 0.08</size>
          </box>
        </geometry>
      </collision>

      <!-- Passive U-catcher sized for 10 cm balls on smooth surfaces. -->
      <visual name="catcher_left_visual">
        <pose>0.115 0.065 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.01 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.08 0.08 0.08 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>

      <visual name="catcher_right_visual">
        <pose>0.115 -0.065 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.01 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.08 0.08 0.08 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>

      <visual name="catcher_rear_visual">
        <pose>0.075 0.000 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.14 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.08 0.08 0.08 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>

      <collision name="catcher_left_collision">
        <pose>0.115 0.065 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.01 0.04</size>
          </box>
        </geometry>
      </collision>

      <collision name="catcher_right_collision">
        <pose>0.115 -0.065 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.09 0.01 0.04</size>
          </box>
        </geometry>
      </collision>

      <collision name="catcher_rear_collision">
        <pose>0.075 0.000 -0.022 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.14 0.04</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- D415 Camera Link -->
    <link name="d415_camera_link">
      <!-- Position: 7.5cm forward from center, 10cm up from ground -->
      <pose>0.075 0 0.10 0 0 0</pose>
      
      <inertial>
        <mass>0.072</mass>  <!-- D415 actual mass: 72g -->
        <inertia>
          <!-- Small box inertia approximation -->
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="d415_visual">
        <geometry>
          <box>
            <!-- D415 dimensions: 99mm x 20mm x 23mm -->
            <size>0.099 0.020 0.023</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      
      <collision name="d415_collision">
        <geometry>
          <box>
            <size>0.099 0.020 0.023</size>
          </box>
        </geometry>
      </collision>
      
      <!-- RGB Camera Sensor for D415 -->
      <sensor name="d415_color" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>d415/color/image_raw</topic>
        
        <camera>
          <horizontal_fov>1.211</horizontal_fov>  <!-- 69.4 degrees for D415 -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      
      <!-- Depth Camera Sensor for D415 -->
      <sensor name="d415_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>d415/depth/image_raw</topic>
        
        <camera>
          <horizontal_fov>1.211</horizontal_fov>  <!-- 69.4 degrees for D415 -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.165</near>  <!-- D415 minimum depth -->
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0025</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <!-- Observer Camera Link for operator-facing chase view -->
    <link name="observer_camera_link">
      <!-- High trailing chase camera that keeps the robot body and forward play space visible -->
      <pose>-1.35 0 1.15 0 0.78 0</pose>

      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="observer_world" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>observer/image_raw</topic>

        <camera>
          <horizontal_fov>1.60</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
      <pose>0 0.08 0.032 1.5708 0 0</pose>
      
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000064</ixx>
          <iyy>0.000064</iyy>
          <izz>0.0001024</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Right Wheel -->
    <link name="right_wheel">
      <pose>0 -0.08 0.032 1.5708 0 0</pose>
      
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000064</ixx>
          <iyy>0.000064</iyy>
          <izz>0.0001024</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Front Caster -->
    <link name="caster_front">
      <pose>0.06 0 0.015 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000009</ixx>
          <iyy>0.000009</iyy>
          <izz>0.000009</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="caster_front_visual">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="caster_front_collision">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Back Caster -->
    <link name="caster_back">
      <pose>-0.06 0 0.015 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000009</ixx>
          <iyy>0.000009</iyy>
          <izz>0.000009</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="caster_back_visual">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="caster_back_collision">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Joints -->
    
    <!-- D415 Camera Joint -->
    <joint name="d415_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>d415_camera_link</child>
    </joint>

    <!-- Observer Camera Joint -->
    <joint name="observer_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>observer_camera_link</child>
    </joint>
    
    <!-- Left Wheel Joint -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.7</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Right Wheel Joint -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.7</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Front Caster Joint -->
    <joint name="caster_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_front</child>
    </joint>

    <!-- Back Caster Joint -->
    <joint name="caster_back_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_back</child>
    </joint>

    <!-- ROS 2 Control Configuration -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <!-- gz_ros2_control Plugin -->
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <remapping>/controller_manager/robot_description:=/robot_description</remapping>
      </ros>
    </plugin>

    <!-- Pose Publisher Plugin for Ignition -->
    <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

  </model>
</sdf>
