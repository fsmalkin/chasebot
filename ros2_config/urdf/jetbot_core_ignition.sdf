<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="jetbot">
    
    <!-- Base Link - Main Chassis -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.0395</ixx>
          <iyy>0.0495</iyy>
          <izz>0.0595</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.15 0.12 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1.0</ambient>
          <diffuse>0.2 0.4 0.8 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.15 0.12 0.08</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
      <pose>0 0.08 0.032 1.5708 0 0</pose>
      
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000064</ixx>
          <iyy>0.000064</iyy>
          <izz>0.0001024</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Right Wheel -->
    <link name="right_wheel">
      <pose>0 -0.08 0.032 1.5708 0 0</pose>
      
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000064</ixx>
          <iyy>0.000064</iyy>
          <izz>0.0001024</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Front Caster -->
    <link name="caster_front">
      <pose>0.06 0 0.015 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000009</ixx>
          <iyy>0.000009</iyy>
          <izz>0.000009</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="caster_front_visual">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="caster_front_collision">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Back Caster -->
    <link name="caster_back">
      <pose>-0.06 0 0.015 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000009</ixx>
          <iyy>0.000009</iyy>
          <izz>0.000009</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="caster_back_visual">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="caster_back_collision">
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Joints -->
    
    <!-- Left Wheel Joint -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.7</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Right Wheel Joint -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.7</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Front Caster Joint -->
    <joint name="caster_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_front</child>
    </joint>

    <!-- Back Caster Joint -->
    <joint name="caster_back_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_back</child>
    </joint>

    <!-- ROS 2 Control Configuration -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <!-- gz_ros2_control Plugin -->
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find chasebot_description)/config/jetbot_controllers.yaml</parameters>
      <ros>
        <remapping>/controller_manager/robot_description:=/robot_description</remapping>
      </ros>
    </plugin>

    <!-- Pose Publisher Plugin for Ignition -->
    <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

  </model>
</sdf>
