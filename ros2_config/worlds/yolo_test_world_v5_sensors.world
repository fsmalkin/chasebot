<?xml version="1.0"?>
<sdf version="1.6">
  <world name="yolo_test_world">
    <!-- Physics settings for better performance -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!-- CRITICAL: Sensors system plugin for camera functionality -->
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- Scene settings with blue sky -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.5 0.7 1.0 1</background>  <!-- Blue sky -->
      <shadows>1</shadows>
    </scene>

    <!-- Sun light source -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane with green grass color -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>  <!-- Green grass -->
            <diffuse>0.1 0.8 0.1 1</diffuse>
            <specular>0.05 0.1 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- RED ball - FORWARD (positive X) - LARGER SIZE -->
    <model name="red_ball_forward">
      <pose>1.0 0.0 0.05 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.046</mass>
          <inertia>
            <ixx>0.0000307</ixx>
            <iyy>0.0000307</iyy>
            <izz>0.0000307</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>  <!-- Red color -->
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.3 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- BLUE ball - LEFT (positive Y) - LARGER SIZE -->
    <model name="blue_ball_left">
      <pose>0.0 1.0 0.05 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.046</mass>
          <inertia>
            <ixx>0.0000307</ixx>
            <iyy>0.0000307</iyy>
            <izz>0.0000307</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>  <!-- Blue color -->
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- YELLOW ball - RIGHT (negative Y) - LARGER SIZE -->
    <model name="yellow_ball_right">
      <pose>0.0 -1.0 0.05 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.046</mass>
          <inertia>
            <ixx>0.0000307</ixx>
            <iyy>0.0000307</iyy>
            <izz>0.0000307</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 0.0 1</ambient>  <!-- Yellow color -->
            <diffuse>1.0 1.0 0.0 1</diffuse>
            <specular>0.3 0.3 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- WHITE ball - BEHIND (negative X) - LARGER SIZE -->
    <model name="white_ball_behind">
      <pose>-1.0 0.0 0.05 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.046</mass>
          <inertia>
            <ixx>0.0000307</ixx>
            <iyy>0.0000307</iyy>
            <izz>0.0000307</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- Larger radius -->
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>  <!-- White color -->
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
