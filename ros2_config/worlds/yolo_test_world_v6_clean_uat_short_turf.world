<?xml version="1.0"?>
<sdf version="1.6">
  <world name="yolo_test_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.5 0.7 1.0 1</background>
      <shadows>1</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>40</mu>
                <mu2>36</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
              <torsional>
                <coefficient>1.4</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.05</patch_radius>
                <ode>
                  <slip>0.0</slip>
                </ode>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>400000.0</kp>
                <kd>40.0</kd>
                <max_vel>0.02</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.56 0.16 1</ambient>
            <diffuse>0.15 0.56 0.16 1</diffuse>
            <specular>0.05 0.1 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ground_reference_markers">
      <static>true</static>
      <link name="link">
        <visual name="x_axis">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <box>
              <size>5.0 0.03 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.24 0.24 1</ambient>
            <diffuse>0.20 0.24 0.24 1</diffuse>
          </material>
        </visual>
        <visual name="y_axis">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <box>
              <size>0.03 5.0 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.24 0.24 1</ambient>
            <diffuse>0.20 0.24 0.24 1</diffuse>
          </material>
        </visual>
        <visual name="grid_x_pos_05">
          <pose>0.5 0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 4.0 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.80 1</ambient>
            <diffuse>0.78 0.82 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="grid_x_neg_05">
          <pose>-0.5 0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 4.0 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.80 1</ambient>
            <diffuse>0.78 0.82 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="grid_x_pos_10">
          <pose>1.0 0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 4.0 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.74 0.72 1</ambient>
            <diffuse>0.70 0.74 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="grid_x_neg_10">
          <pose>-1.0 0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 4.0 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.74 0.72 1</ambient>
            <diffuse>0.70 0.74 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="grid_y_pos_05">
          <pose>0 0.5 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>4.0 0.012 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.80 1</ambient>
            <diffuse>0.78 0.82 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="grid_y_neg_05">
          <pose>0 -0.5 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>4.0 0.012 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.80 1</ambient>
            <diffuse>0.78 0.82 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="grid_y_pos_10">
          <pose>0 1.0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>4.0 0.012 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.74 0.72 1</ambient>
            <diffuse>0.70 0.74 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="grid_y_neg_10">
          <pose>0 -1.0 0.0008 0 0 0</pose>
          <geometry>
            <box>
              <size>4.0 0.012 0.0015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.74 0.72 1</ambient>
            <diffuse>0.70 0.74 0.72 1</diffuse>
          </material>
        </visual>
        <visual name="origin_pad">
          <pose>0 0 0.0012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.14 0.14 0.0022</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.88 1</ambient>
            <diffuse>0.92 0.92 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="overview_observer_camera">
      <static>true</static>
      <pose>-2.35 0 1.75 0 0.60 0</pose>
      <link name="link">
        <sensor name="overview_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <topic>observer_world/image_raw</topic>
          <camera>
            <horizontal_fov>1.28</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
